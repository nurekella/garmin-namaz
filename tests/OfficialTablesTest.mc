using Toybox.Test;
using Toybox.Lang;

// Regression against the official ҚМДБ tables (api.muftyat.kz/prayer-times/2026/{lat}/{lng}),
// snapshotted here so the watch never needs the network. 7 places x 6 dates:
// winter, spring, the week the northern twilight cap starts (May 10),
// the summer solstice, late summer and midwinter. Rows:
// [place, lat, lon, year, month, day, fajr, sunrise, dhuhr, asr, maghrib, isha]
// Whole-year fit (36 places) is within 1 min of the official minute for
// 86-100% of days per prayer; the worst Fajr/Isha miss is 3.3 min.
module OfficialTablesTest {

    const ROWS = [
        ["Алматы", 43.238293d, 76.945465d, 2026, 1, 15, "05:58", "07:19", "12:05", "15:03", "16:45", "18:06"],
        ["Алматы", 43.238293d, 76.945465d, 2026, 4, 29, "03:20", "04:46", "11:53", "16:49", "18:54", "20:20"],
        ["Алматы", 43.238293d, 76.945465d, 2026, 5, 10, "03:00", "04:31", "11:52", "16:56", "19:07", "20:38"],
        ["Алматы", 43.238293d, 76.945465d, 2026, 6, 21, "02:23", "04:09", "11:57", "17:16", "19:39", "21:25"],
        ["Алматы", 43.238293d, 76.945465d, 2026, 8, 15, "03:29", "04:54", "12:00", "16:55", "18:59", "20:24"],
        ["Алматы", 43.238293d, 76.945465d, 2026, 12, 21, "05:55", "07:18", "11:53", "14:41", "16:23", "17:46"],
        ["Астана", 51.133333d, 71.433333d, 2026, 1, 15, "06:32", "08:07", "12:29", "14:54", "16:41", "18:16"],
        ["Астана", 51.133333d, 71.433333d, 2026, 4, 29, "02:59", "04:46", "12:17", "17:20", "19:38", "21:26"],
        ["Астана", 51.133333d, 71.433333d, 2026, 5, 10, "02:28", "04:27", "12:16", "17:31", "19:55", "21:55"],
        ["Астана", 51.133333d, 71.433333d, 2026, 6, 21, "02:07", "03:54", "12:21", "17:58", "20:38", "22:25"],
        ["Астана", 51.133333d, 71.433333d, 2026, 8, 15, "03:09", "04:55", "12:24", "17:26", "19:41", "21:27"],
        ["Астана", 51.133333d, 71.433333d, 2026, 12, 21, "06:32", "08:10", "12:17", "14:28", "16:14", "17:52"],
        ["Петропавл", 54.862222d, 69.140833d, 2026, 1, 15, "06:48", "08:34", "12:38", "14:43", "16:33", "18:18"],
        ["Петропавл", 54.862222d, 69.140833d, 2026, 4, 29, "02:37", "04:44", "12:26", "17:33", "19:59", "22:07"],
        ["Петропавл", 54.862222d, 69.140833d, 2026, 5, 10, "02:23", "04:21", "12:25", "17:46", "20:20", "22:18"],
        ["Петропавл", 54.862222d, 69.140833d, 2026, 6, 21, "02:05", "03:40", "12:30", "18:16", "21:10", "22:45"],
        ["Петропавл", 54.862222d, 69.140833d, 2026, 8, 15, "02:47", "04:53", "12:33", "17:38", "20:02", "22:07"],
        ["Петропавл", 54.862222d, 69.140833d, 2026, 12, 21, "06:50", "08:40", "12:26", "14:15", "16:02", "17:53"],
        ["Ақтау", 43.635379d, 51.169135d, 2026, 1, 15, "07:41", "09:03", "13:48", "16:44", "18:27", "19:49"],
        ["Ақтау", 43.635379d, 51.169135d, 2026, 4, 29, "05:01", "06:28", "13:36", "18:32", "20:38", "22:05"],
        ["Ақтау", 43.635379d, 51.169135d, 2026, 5, 10, "04:41", "06:13", "13:35", "18:40", "20:51", "22:23"],
        ["Ақтау", 43.635379d, 51.169135d, 2026, 6, 21, "04:03", "05:51", "13:40", "19:00", "21:23", "23:11"],
        ["Ақтау", 43.635379d, 51.169135d, 2026, 8, 15, "05:10", "06:37", "13:43", "18:38", "20:42", "22:09"],
        ["Ақтау", 43.635379d, 51.169135d, 2026, 12, 21, "07:39", "09:02", "13:36", "16:22", "18:04", "19:28"],
        ["Қостанай", 53.219333d, 63.634194d, 2026, 1, 15, "07:07", "08:47", "13:00", "15:14", "17:03", "18:43"],
        ["Қостанай", 53.219333d, 63.634194d, 2026, 4, 29, "03:14", "05:11", "12:48", "17:54", "20:15", "22:13"],
        ["Қостанай", 53.219333d, 63.634194d, 2026, 5, 10, "02:49", "04:50", "12:47", "18:05", "20:35", "22:36"],
        ["Қостанай", 53.219333d, 63.634194d, 2026, 6, 21, "02:33", "04:13", "12:52", "18:34", "21:22", "23:02"],
        ["Қостанай", 53.219333d, 63.634194d, 2026, 8, 15, "03:24", "05:20", "12:55", "17:59", "20:19", "22:14"],
        ["Қостанай", 53.219333d, 63.634194d, 2026, 12, 21, "07:08", "08:53", "12:48", "14:47", "16:34", "18:19"],
        ["Ақтөбе", 50.300377d, 57.154555d, 2026, 1, 15, "07:28", "09:00", "13:26", "15:55", "17:42", "19:14"],
        ["Ақтөбе", 50.300377d, 57.154555d, 2026, 4, 29, "04:02", "05:46", "13:14", "18:17", "20:32", "22:17"],
        ["Ақтөбе", 50.300377d, 57.154555d, 2026, 5, 10, "03:33", "05:27", "13:13", "18:27", "20:49", "22:44"],
        ["Ақтөбе", 50.300377d, 57.154555d, 2026, 6, 21, "03:07", "04:55", "13:18", "18:53", "21:31", "23:20"],
        ["Ақтөбе", 50.300377d, 57.154555d, 2026, 8, 15, "04:12", "05:55", "13:21", "18:22", "20:36", "22:19"],
        ["Ақтөбе", 50.300377d, 57.154555d, 2026, 12, 21, "07:28", "09:04", "13:14", "15:29", "17:15", "18:51"],
        ["Шымкент", 42.368009d, 69.612769d, 2026, 1, 15, "06:26", "07:45", "12:34", "15:35", "17:17", "18:37"],
        ["Шымкент", 42.368009d, 69.612769d, 2026, 4, 29, "03:53", "05:17", "12:22", "17:17", "19:22", "20:46"],
        ["Шымкент", 42.368009d, 69.612769d, 2026, 5, 10, "03:34", "05:03", "12:21", "17:24", "19:34", "21:03"],
        ["Шымкент", 42.368009d, 69.612769d, 2026, 6, 21, "02:59", "04:42", "12:26", "17:44", "20:05", "21:47"],
        ["Шымкент", 42.368009d, 69.612769d, 2026, 8, 15, "04:01", "05:25", "12:29", "17:23", "19:26", "20:50"],
        ["Шымкент", 42.368009d, 69.612769d, 2026, 12, 21, "06:22", "07:44", "12:23", "15:13", "16:55", "18:17"]
    ];
    const NAMES = ["Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha"];
    const KEYS  = [:fajr, :sunrise, :dhuhr, :asr, :maghrib, :isha];
    // Minutes of slack: Fajr/Isha swing most around the cap switch.
    const TOL   = [3.5d, 2.5d, 2.5d, 2.5d, 2.5d, 3.5d];

    function _hours(hhmm) {
        return hhmm.substring(0, 2).toNumber() + hhmm.substring(3, 5).toNumber() / 60.0d;
    }

    (:test)
    function testMatchesOfficialTables(logger) {
        var calc = new PrayerCalculator(DumkMethod.params(), 2, null);
        var ok = true;
        for (var i = 0; i < ROWS.size(); i++) {
            var r = ROWS[i];
            var t = calc.calculate(r[1], r[2], r[3], r[4], r[5], 5);
            for (var k = 0; k < 6; k++) {
                if (t[KEYS[k]] == null) {
                    logger.error(r[0] + " " + r[3] + "-" + r[4] + "-" + r[5] + " " + NAMES[k] + " is null");
                    ok = false;
                    continue;
                }
                var diff = (t[KEYS[k]] - _hours(r[6 + k])) * 60.0d;
                if (diff < 0.0d) { diff = -diff; }
                if (diff > TOL[k]) {
                    logger.error(r[0] + " " + r[3] + "-" + r[4] + "-" + r[5] + " " + NAMES[k]
                                 + " off by " + diff.format("%.1f") + " min (want " + r[6 + k] + ")");
                    ok = false;
                }
            }
        }
        return ok;
    }

    // The point of the cap rule: in June Petropavl has no real night twilight.
    // Official: Fajr 02:05, Isha 22:45 on 2026-06-21.
    (:test)
    function testSummerNorthHasFajrAndIsha(logger) {
        var calc = new PrayerCalculator(DumkMethod.params(), 2, null);
        var t = calc.calculate(54.862222d, 69.140833d, 2026, 6, 21, 5);
        if (t[:fajr] == null || t[:isha] == null) { logger.error("null Fajr/Isha"); return false; }
        return t[:fajr] < t[:sunrise] && t[:isha] > t[:maghrib];
    }
}
